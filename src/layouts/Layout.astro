---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Avanti Logística | Agente de Carga Internacional en Colombia',
  description = 'Agente de carga internacional en Colombia. Fletes marítimos FCL/LCL, aéreos, terrestres, tramitación aduanera, seguro de carga y consultoría en comercio exterior. Solicita tu cotización.',
  ogImage = '/HomepageCorrecta.jpg'
} = Astro.props;

const siteUrl = 'https://avanti3-0.vercel.app';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/jpeg" href="/logo.jpg" />

    <!-- SEO primario -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="agente de carga, agente de carga internacional, logística internacional Colombia, fletes marítimos Colombia, fletes aéreos Colombia, transporte de carga, importaciones Colombia, exportaciones Colombia, comercio exterior Colombia, agencia de aduanas, trámites aduaneros, courier internacional Colombia" />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Avanti Logística" />
    <link rel="canonical" href={siteUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="Avanti Logística" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- Schema.org: Agencia de carga -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Avanti Logística",
      "description": "Agente de carga internacional en Colombia. Especialistas en fletes marítimos FCL/LCL, aéreos, terrestres, tramitación aduanera, seguro de carga y consultoría en comercio exterior.",
      "url": "https://avanti3-0.vercel.app",
      "telephone": "+573015006672",
      "email": "gerencia@avantilogistica.com",
      "image": "https://avanti3-0.vercel.app/logo.jpg",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "CO",
        "addressRegion": "Colombia"
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
        "opens": "08:00",
        "closes": "18:00"
      },
      "sameAs": []
    }
    </script>
  </head>
  <body class="bg-white">
    <Header />
    <slot />
    <Footer />

    <!-- Botón flotante WhatsApp -->
    <a
      href="https://wa.me/573015006672?text=Hola%2C%20necesito%20información%20sobre%20sus%20servicios%20de%20carga%20internacional"
      target="_blank"
      rel="noopener noreferrer"
      class="fixed bottom-6 right-6 z-50 flex items-center justify-center w-14 h-14 bg-green-500 hover:bg-green-600 rounded-full shadow-xl transition-transform hover:scale-110"
      aria-label="Contactar por WhatsApp"
    >
      <svg class="w-8 h-8 fill-white" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>
  </body>
</html>

<style>
  html, body {
    margin: 0;
    width: 100%;
    height: 100%;
    padding: 0;
  }
</style>
