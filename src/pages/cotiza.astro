---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Cotiza aquí | Avanti Logística — Cotización de carga internacional"
  description="Solicita tu cotización de carga internacional en línea. Fletes marítimos FCL/LCL, aéreos, terrestres y trámites aduaneros. Respuesta en menos de 2 horas hábiles."
>

  <section class="bg-[#001540] py-20 text-center">
    <div class="max-w-3xl mx-auto px-6">
      <p class="text-[#C9A84C] font-semibold text-sm uppercase tracking-widest mb-3">Cotización sin costo</p>
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Cotiza aquí</h1>
      <p class="text-gray-300 text-lg">Cuéntanos sobre tu embarque y te enviamos una propuesta a la medida.</p>
    </div>
  </section>

  <section class="py-20 bg-gray-50">
    <div class="max-w-2xl mx-auto px-6">

      <div class="bg-white rounded-xl shadow-sm p-8 md:p-10">
        <!-- El endpoint devuelve aquí con ?error=1 si no se pudo registrar la solicitud -->
        <div id="aviso-error" class="hidden mb-8 border-l-4 border-red-500 bg-red-50 rounded-r-lg p-4">
          <p class="text-sm text-red-800 leading-relaxed">
            <strong>No pudimos registrar tu solicitud.</strong> Por favor inténtalo de nuevo, o escríbenos
            por <a href="https://wa.me/573015006672" target="_blank" rel="noopener noreferrer" class="font-semibold underline">WhatsApp</a>
            para atenderte de inmediato.
          </p>
        </div>

        <p class="text-gray-500 text-sm mb-8 text-center">
          Entre más datos nos compartas, más precisa será la cotización. Respondemos en menos de <strong>2 horas hábiles</strong>.
        </p>

        <form action="/api/cotizar" method="POST" class="space-y-5">

          <!-- Datos de contacto -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1" for="nombre">Nombre completo *</label>
            <input
              type="text" id="nombre" name="nombre"
              class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#002366] text-sm"
              placeholder="Tu nombre" required
            />
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1" for="empresa">Empresa</label>
            <input
              type="text" id="empresa" name="empresa"
              class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#002366] text-sm"
              placeholder="Razón social o NIT"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1" for="email">Correo electrónico *</label>
              <input
                type="email" id="email" name="email"
                class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#002366] text-sm"
                placeholder="tucorreo@ejemplo.com" required
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1" for="telefono">Teléfono / WhatsApp *</label>
              <input
                type="tel" id="telefono" name="telefono"
                class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#002366] text-sm"
                placeholder="+57 300 000 0000" required
              />
            </div>
          </div>

          <!-- Datos del embarque -->
          <div class="pt-3 border-t border-gray-100">
            <p class="text-xs uppercase tracking-widest text-[#C9A84C] font-semibold mb-4 pt-3">Datos del embarque</p>

            <div class="space-y-5">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1" for="servicio">Tipo de servicio *</label>
                  <select
                    id="servicio" name="servicio"
                    class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#002366] text-sm bg-white" required
                  >
                    <option value="">Selecciona una opción</option>
                    <option value="maritimo-fcl">Marítimo FCL (contenedor completo)</option>
                    <option value="maritimo-lcl">Marítimo LCL (carga consolidada)</option>
                    <option value="aereo">Aéreo</option>
                    <option value="terrestre">Terrestre</option>
                    <option value="aduanero">Trámite aduanero</option>
                    <option value="courier">Courier / mensajería</option>
                    <option value="almacenamiento">Almacenamiento</option>
                    <option value="otro">Otro</option>
                  </select>
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1" for="operacion">Operación *</label>
                  <select
                    id="operacion" name="operacion"
                    class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#002366] text-sm bg-white" required
                  >
                    <option value="">Selecciona una opción</option>
                    <option value="importacion">Importación</option>
                    <option value="exportacion">Exportación</option>
                    <option value="nacional">Nacional</option>
                  </select>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1" for="origen">Origen *</label>
                  <input
                    type="text" id="origen" name="origen"
                    class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#002366] text-sm"
                    placeholder="Ciudad / puerto / país" required
                  />
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1" for="destino">Destino *</label>
                  <input
                    type="text" id="destino" name="destino"
                    class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#002366] text-sm"
                    placeholder="Ciudad / puerto / país" required
                  />
                </div>
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1" for="mercancia">Descripción de la mercancía *</label>
                <input
                  type="text" id="mercancia" name="mercancia"
                  class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#002366] text-sm"
                  placeholder="Ej: repuestos automotrices, textiles, maquinaria..." required
                />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1" for="peso">Peso total (kg)</label>
                  <input
                    type="text" id="peso" name="peso"
                    class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#002366] text-sm"
                    placeholder="1500"
                  />
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1" for="volumen">Volumen (m³)</label>
                  <input
                    type="text" id="volumen" name="volumen"
                    class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#002366] text-sm"
                    placeholder="3.5"
                  />
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1" for="incoterm">Incoterm</label>
                  <select
                    id="incoterm" name="incoterm"
                    class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#002366] text-sm bg-white"
                  >
                    <option value="">No lo sé</option>
                    <option value="EXW">EXW</option>
                    <option value="FCA">FCA</option>
                    <option value="FOB">FOB</option>
                    <option value="CFR">CFR</option>
                    <option value="CIF">CIF</option>
                    <option value="DAP">DAP</option>
                    <option value="DDP">DDP</option>
                  </select>
                </div>
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1" for="fecha">Fecha estimada de embarque</label>
                <input
                  type="date" id="fecha" name="fecha"
                  class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#002366] text-sm"
                />
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1" for="comentarios">Comentarios adicionales</label>
                <textarea
                  id="comentarios" name="comentarios" rows="4"
                  class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#002366] text-sm resize-none"
                  placeholder="Carga peligrosa, refrigerada, sobredimensionada, requerimientos especiales..."
                ></textarea>
              </div>
            </div>
          </div>

          <button
            type="submit"
            class="w-full bg-[#002366] hover:bg-[#003087] text-white font-semibold py-3 rounded-lg transition-colors shadow"
          >
            Solicitar cotización
          </button>
        </form>

        <div class="mt-8 pt-6 border-t border-gray-100 text-center space-y-3">
          <p class="text-sm text-gray-500">¿Prefieres cotizar por otro medio?</p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a
              href="https://wa.me/573015006672?text=Hola%2C%20quiero%20solicitar%20una%20cotización%20de%20carga%20internacional"
              target="_blank" rel="noopener noreferrer"
              class="flex items-center justify-center gap-2 bg-green-500 hover:bg-green-600 text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition-colors"
            >
              <svg class="w-4 h-4 fill-white" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              WhatsApp
            </a>
            <a
              href="mailto:gerencia@avantilogistica.com"
              class="flex items-center justify-center gap-2 border border-gray-200 hover:border-[#002366] text-gray-700 hover:text-[#002366] text-sm font-semibold px-5 py-2.5 rounded-lg transition-colors"
            >
              Correo electrónico
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    if (new URLSearchParams(location.search).get('error') === '1') {
      const aviso = document.getElementById('aviso-error');
      if (aviso) {
        aviso.classList.remove('hidden');
        aviso.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }
  </script>

</Layout>
