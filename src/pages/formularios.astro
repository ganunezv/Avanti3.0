---
import Layout from '../layouts/Layout.astro';

// TODO: reemplazar por los formularios reales.
// Para habilitar una descarga: sube el PDF a /public/formularios/ y
// cambia `archivo: null` por `archivo: '/formularios/nombre-del-archivo.pdf'`.
const formularios = [
  {
    titulo: 'Vinculación de cliente o proveedor',
    descripcion: 'Formatos y documentos requeridos para iniciar operaciones con Avanti Logística como cliente o como proveedor.',
    archivo: null,
    enlace: '/vinculacion',
  },
  {
    titulo: 'Instrucciones de embarque',
    descripcion: 'Datos del shipper, consignee, mercancía e Incoterm para coordinar la reserva y emisión del documento de transporte.',
    archivo: null,
  },
  {
    titulo: 'Autorización de tratamiento de datos',
    descripcion: 'Consentimiento para el manejo de datos personales conforme a la Ley 1581 de 2012.',
    archivo: null,
  },
  {
    titulo: 'Declaración de mercancía peligrosa',
    descripcion: 'Formato obligatorio para cargas clasificadas como IMO / DGR, con clase, número UN y ficha de seguridad.',
    archivo: null,
  },
];
---

<Layout
  title="Formularios | Avanti Logística — Descarga de formatos"
  description="Descarga los formularios y formatos de Avanti Logística: vinculación de cliente, instrucciones de embarque, tratamiento de datos y mercancía peligrosa."
>

  <section class="bg-[#001540] py-20 text-center">
    <div class="max-w-3xl mx-auto px-6">
      <p class="text-[#C9A84C] font-semibold text-sm uppercase tracking-widest mb-3">Documentación</p>
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Formularios</h1>
      <p class="text-gray-300 text-lg">Descarga los formatos que necesitas para tu operación logística.</p>
    </div>
  </section>

  <section class="py-20 bg-gray-50">
    <div class="max-w-5xl mx-auto px-6">

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {formularios.map((f) => (
          <div class="bg-white rounded-xl shadow-sm p-7 flex flex-col">
            <div class="w-12 h-12 bg-[#002366]/10 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 stroke-[#002366]" fill="none" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
              </svg>
            </div>

            <h2 class="font-bold text-[#001540] text-lg mb-2">{f.titulo}</h2>
            <p class="text-sm text-gray-500 leading-relaxed mb-6 grow">{f.descripcion}</p>

            {f.enlace ? (
              <a
                href={f.enlace}
                class="inline-flex items-center justify-center gap-2 bg-[#002366] hover:bg-[#003087] text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition-colors shadow"
              >
                Ver requisitos
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </a>
            ) : f.archivo ? (
              <a
                href={f.archivo}
                download
                class="inline-flex items-center justify-center gap-2 bg-[#002366] hover:bg-[#003087] text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition-colors shadow"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                </svg>
                Descargar formato
              </a>
            ) : (
              <span class="inline-flex items-center justify-center gap-2 border border-dashed border-gray-300 text-gray-400 text-sm font-semibold px-5 py-2.5 rounded-lg cursor-not-allowed">
                Próximamente
              </span>
            )}
          </div>
        ))}
      </div>

      <!-- Ayuda -->
      <div class="mt-12 bg-white rounded-xl shadow-sm p-8 text-center">
        <h2 class="text-xl font-bold text-[#001540] mb-2">¿No encuentras el formato que necesitas?</h2>
        <p class="text-gray-500 text-sm mb-6 max-w-xl mx-auto">
          Escríbenos y te lo enviamos directamente. También podemos ayudarte a diligenciarlo si es tu primera operación con nosotros.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a
            href="https://wa.me/573015006672?text=Hola%2C%20necesito%20un%20formato%20o%20formulario%20de%20Avanti%20Logística"
            target="_blank" rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 bg-green-500 hover:bg-green-600 text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition-colors"
          >
            <svg class="w-4 h-4 fill-white" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp
          </a>
          <a
            href="mailto:gerencia@avantilogistica.com"
            class="flex items-center justify-center gap-2 border border-gray-200 hover:border-[#002366] text-gray-700 hover:text-[#002366] text-sm font-semibold px-5 py-2.5 rounded-lg transition-colors"
          >
            Correo electrónico
          </a>
        </div>
      </div>

    </div>
  </section>

</Layout>
