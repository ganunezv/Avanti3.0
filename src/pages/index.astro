---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Avanti Logística | Agente de Carga Internacional en Colombia"
  description="Agente de carga internacional en Colombia. Fletes marítimos FCL/LCL, aéreos, terrestres, tramitación aduanera y consultoría en comercio exterior. Solicita tu cotización hoy."
>

  <!-- ======================================
       HERO
  ======================================= -->
  <section
    class="relative min-h-[90vh] flex items-center"
    style="background-image: url('/HomepageCorrecta.jpg'); background-size: cover; background-position: center;"
    aria-label="Inicio"
  >
    <!-- Overlay -->
    <div class="absolute inset-0 bg-[#001540]/80"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 py-20 lg:py-32">
      <div class="max-w-2xl">
        <p class="text-[#C9A84C] font-semibold text-sm uppercase tracking-widest mb-3">
          Agente de Carga Internacional · Colombia
        </p>
        <h1 class="text-white text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-6">
          Movemos tu carga<br />al mundo entero
        </h1>
        <p class="text-gray-200 text-lg leading-relaxed mb-8">
          Somos especialistas en soluciones logísticas para importaciones y exportaciones. Marítimo, aéreo, terrestre y tramitación aduanera — todo en un solo lugar.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="https://wa.me/573015006672?text=Hola%2C%20necesito%20una%20cotización%20de%20carga%20internacional"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 bg-green-500 hover:bg-green-600 text-white font-semibold px-7 py-3.5 rounded-md shadow-lg transition-all hover:scale-105"
          >
            <svg class="w-5 h-5 fill-white" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Cotizar por WhatsApp
          </a>
          <a
            href="mailto:gerencia@avantilogistica.com"
            class="flex items-center justify-center gap-2 bg-transparent border-2 border-white hover:bg-white hover:text-[#002366] text-white font-semibold px-7 py-3.5 rounded-md transition-all"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
            Escribir al correo
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================
       BARRA DE CONFIANZA
  ======================================= -->
  <section class="bg-[#002366] text-white py-8">
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
      <div>
        <p class="text-3xl font-bold text-[#C9A84C]">+10</p>
        <p class="text-sm text-gray-300 mt-1">Años de experiencia</p>
      </div>
      <div>
        <p class="text-3xl font-bold text-[#C9A84C]">+50</p>
        <p class="text-sm text-gray-300 mt-1">Países de operación</p>
      </div>
      <div>
        <p class="text-3xl font-bold text-[#C9A84C]">+500</p>
        <p class="text-sm text-gray-300 mt-1">Clientes satisfechos</p>
      </div>
      <div>
        <p class="text-3xl font-bold text-[#C9A84C]">24/7</p>
        <p class="text-sm text-gray-300 mt-1">Seguimiento de carga</p>
      </div>
    </div>
  </section>

  <!-- ======================================
       SERVICIOS
  ======================================= -->
  <section id="servicios" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-14">
        <p class="text-[#C9A84C] font-semibold text-sm uppercase tracking-widest mb-2">Lo que hacemos</p>
        <h2 class="text-3xl md:text-4xl font-bold text-[#001540]">Nuestros Servicios</h2>
        <p class="text-gray-500 mt-3 max-w-xl mx-auto">
          Soluciones logísticas completas para que tu mercancía llegue segura, a tiempo y con los costos más competitivos del mercado.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">

        <!-- Marítimo -->
        <div class="group border border-gray-100 rounded-xl p-6 hover:shadow-lg hover:border-[#002366] transition-all">
          <div class="w-12 h-12 bg-[#002366]/10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-[#002366] transition-colors">
            <svg class="w-6 h-6 stroke-[#002366] group-hover:stroke-white transition-colors" fill="none" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.429 9.75L2.25 12l4.179 2.25m0-4.5l5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-9.75 5.25L2.25 12l4.179-2.25m0 0l5.571 3" />
            </svg>
          </div>
          <h3 class="font-bold text-[#001540] mb-2">Fletes Marítimos</h3>
          <p class="text-sm text-gray-500 leading-relaxed">Contenedores completos (FCL) y carga consolidada (LCL) hacia y desde los principales puertos del mundo.</p>
        </div>

        <!-- Aéreo -->
        <div class="group border border-gray-100 rounded-xl p-6 hover:shadow-lg hover:border-[#002366] transition-all">
          <div class="w-12 h-12 bg-[#002366]/10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-[#002366] transition-colors">
            <svg class="w-6 h-6 stroke-[#002366] group-hover:stroke-white transition-colors" fill="none" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
            </svg>
          </div>
          <h3 class="font-bold text-[#001540] mb-2">Fletes Aéreos</h3>
          <p class="text-sm text-gray-500 leading-relaxed">Transporte aéreo rápido y seguro con las mejores tarifas y tiempos de tránsito para cargas urgentes.</p>
        </div>

        <!-- Terrestre -->
        <div class="group border border-gray-100 rounded-xl p-6 hover:shadow-lg hover:border-[#002366] transition-all">
          <div class="w-12 h-12 bg-[#002366]/10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-[#002366] transition-colors">
            <svg class="w-6 h-6 stroke-[#002366] group-hover:stroke-white transition-colors" fill="none" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
            </svg>
          </div>
          <h3 class="font-bold text-[#001540] mb-2">Transporte Terrestre</h3>
          <p class="text-sm text-gray-500 leading-relaxed">Distribución nacional e internacional, últimas millas y conexión con puertos y aeropuertos.</p>
        </div>

        <!-- Aduana -->
        <div class="group border border-gray-100 rounded-xl p-6 hover:shadow-lg hover:border-[#002366] transition-all">
          <div class="w-12 h-12 bg-[#002366]/10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-[#002366] transition-colors">
            <svg class="w-6 h-6 stroke-[#002366] group-hover:stroke-white transition-colors" fill="none" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
          </div>
          <h3 class="font-bold text-[#001540] mb-2">Trámites Aduaneros</h3>
          <p class="text-sm text-gray-500 leading-relaxed">Gestión eficiente de importaciones y exportaciones ante la DIAN. Evita demoras y sobrecostos.</p>
        </div>

        <!-- Seguro -->
        <div class="group border border-gray-100 rounded-xl p-6 hover:shadow-lg hover:border-[#002366] transition-all">
          <div class="w-12 h-12 bg-[#002366]/10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-[#002366] transition-colors">
            <svg class="w-6 h-6 stroke-[#002366] group-hover:stroke-white transition-colors" fill="none" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0-10.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.75c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.57-.598-3.75h-.152c-3.196 0-6.1-1.249-8.25-3.286zm0 13.036h.008v.008H12v-.008z" />
            </svg>
          </div>
          <h3 class="font-bold text-[#001540] mb-2">Seguro de Carga</h3>
          <p class="text-sm text-gray-500 leading-relaxed">Protección total para tu mercancía durante todo el trayecto. Cubrimos pérdida, daño y robo.</p>
        </div>

        <!-- Courier -->
        <div class="group border border-gray-100 rounded-xl p-6 hover:shadow-lg hover:border-[#002366] transition-all">
          <div class="w-12 h-12 bg-[#002366]/10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-[#002366] transition-colors">
            <svg class="w-6 h-6 stroke-[#002366] group-hover:stroke-white transition-colors" fill="none" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
            </svg>
          </div>
          <h3 class="font-bold text-[#001540] mb-2">Courier y Mensajería</h3>
          <p class="text-sm text-gray-500 leading-relaxed">Envíos ágiles de documentos y paquetería nacional e internacional con trazabilidad en tiempo real.</p>
        </div>

        <!-- Almacenamiento -->
        <div class="group border border-gray-100 rounded-xl p-6 hover:shadow-lg hover:border-[#002366] transition-all">
          <div class="w-12 h-12 bg-[#002366]/10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-[#002366] transition-colors">
            <svg class="w-6 h-6 stroke-[#002366] group-hover:stroke-white transition-colors" fill="none" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m2.25-18v18m13.5-18v18m2.25-18v18M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z" />
            </svg>
          </div>
          <h3 class="font-bold text-[#001540] mb-2">Almacenamiento</h3>
          <p class="text-sm text-gray-500 leading-relaxed">Bodegaje y resguardo seguro de mercancías con control de inventario y gestión logística integrada.</p>
        </div>

        <!-- Asesoría -->
        <div class="group border border-gray-100 rounded-xl p-6 hover:shadow-lg hover:border-[#002366] transition-all">
          <div class="w-12 h-12 bg-[#002366]/10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-[#002366] transition-colors">
            <svg class="w-6 h-6 stroke-[#002366] group-hover:stroke-white transition-colors" fill="none" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6" />
            </svg>
          </div>
          <h3 class="font-bold text-[#001540] mb-2">Consultoría en Comercio Exterior</h3>
          <p class="text-sm text-gray-500 leading-relaxed">Asesoría personalizada en normativa aduanera, clasificación arancelaria y optimización de costos logísticos.</p>
        </div>

      </div>

      <div class="text-center mt-10">
        <a
          href="/nuestrosProductos"
          class="inline-block border-2 border-[#002366] text-[#002366] hover:bg-[#002366] hover:text-white font-semibold px-8 py-3 rounded-md transition-all"
        >
          Ver todos los servicios
        </a>
      </div>
    </div>
  </section>

  <!-- ======================================
       POR QUÉ ELEGIRNOS
  ======================================= -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-14">
        <p class="text-[#C9A84C] font-semibold text-sm uppercase tracking-widest mb-2">Nuestra ventaja</p>
        <h2 class="text-3xl md:text-4xl font-bold text-[#001540]">¿Por qué elegir Avanti?</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white rounded-xl p-8 shadow-sm text-center">
          <div class="w-14 h-14 bg-[#002366] rounded-full flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 stroke-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-[#001540] mb-3">Atención Personalizada</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Un asesor dedicado para tu cuenta. Respondemos en menos de 2 horas y te acompañamos en cada paso del proceso.</p>
        </div>

        <div class="bg-white rounded-xl p-8 shadow-sm text-center">
          <div class="w-14 h-14 bg-[#002366] rounded-full flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 stroke-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-[#001540] mb-3">Tarifas Competitivas</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Negociamos directamente con las principales navieras y aerolíneas para ofrecerte los mejores fletes del mercado colombiano.</p>
        </div>

        <div class="bg-white rounded-xl p-8 shadow-sm text-center">
          <div class="w-14 h-14 bg-[#002366] rounded-full flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 stroke-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-[#001540] mb-3">Cumplimiento y Puntualidad</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Seguimiento en tiempo real de tu carga. Anticipamos imprevistos y garantizamos entregas en los tiempos acordados.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================
       IMAGEN + TEXTO
  ======================================= -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6 flex flex-col lg:flex-row items-center gap-12">
      <div class="w-full lg:w-1/2 rounded-xl overflow-hidden shadow-lg">
        <img
          src="/barco_completo.jpg"
          alt="Operaciones de carga marítima internacional - Avanti Logística Colombia"
          class="w-full h-72 lg:h-96 object-cover"
        />
      </div>
      <div class="w-full lg:w-1/2">
        <p class="text-[#C9A84C] font-semibold text-sm uppercase tracking-widest mb-3">Nuestra operación</p>
        <h2 class="text-3xl font-bold text-[#001540] mb-5">Conectamos a Colombia con el mundo</h2>
        <p class="text-gray-600 leading-relaxed mb-4">
          Como agente de carga internacional con sede en Colombia, operamos en los principales puertos y aeropuertos del país, coordinando embarques hacia y desde más de 50 países en América, Europa, Asia y África.
        </p>
        <p class="text-gray-600 leading-relaxed mb-8">
          Gestionamos el proceso completo: desde la cotización y reserva del espacio, hasta la entrega final y los trámites ante la DIAN. Tú te enfocas en tu negocio; nosotros movemos tu carga.
        </p>
        <a
          href="https://wa.me/573015006672?text=Hola%2C%20quiero%20conocer%20más%20sobre%20sus%20servicios%20de%20carga%20internacional"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#002366] hover:bg-[#003087] text-white font-semibold px-7 py-3 rounded-md transition-colors shadow"
        >
          Hablar con un experto
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ======================================
       ALIADOS
  ======================================= -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-6 text-center">
      <p class="text-gray-400 text-sm uppercase tracking-widest mb-8 font-medium">Trabajamos con los líderes globales del transporte</p>
      <div class="flex flex-wrap items-center justify-center gap-10">
        <img src="/agunzalogo.png" alt="Agunza" class="h-10 w-auto object-contain grayscale hover:grayscale-0 transition-all opacity-70 hover:opacity-100" />
        <img src="/msclogo.png" alt="MSC" class="h-10 w-auto object-contain grayscale hover:grayscale-0 transition-all opacity-70 hover:opacity-100" />
        <img src="/dhllogo.svg" alt="DHL" class="h-10 w-auto object-contain grayscale hover:grayscale-0 transition-all opacity-70 hover:opacity-100" />
        <img src="/fedexlogo.jpg" alt="FedEx" class="h-10 w-auto object-contain grayscale hover:grayscale-0 transition-all opacity-70 hover:opacity-100" />
