---
import Layout from '../layouts/Layout.astro';
//import Particles from '../components/particles.astro'
---

<Layout>
    <div class="flex flex-col lg:flex-row justify-around py-10 px-4 lg:py-24 lg:px-16 gap-8 bg-blue-700">
        
        <div class="w-full lg:w-1/2">
            <h2 class="text-3xl text-white pb-5">
                <span>
                    Transporte de Carga<br>
                    Maritima, Terrestre<br>
                    y Aérea<br>
                </span>
            </h2>
            <div>
                <p class="text-white">
                    Somos una empresa especializada en soluciones de transporte de carga y comercio exterior. Nos comprometemos a brindar un servicio confiable y eficiente. Asegurando que sus mercancias lleguen a su destino de manera segura y puntual. Con experiencia en el sector, ofrecemos asesoria personalizada para optimizar cada envio.
                </p>
            </div>
            <div class="pt-5">
                <a class="inline-block rounded-sm bg-[#4555B7] px-8 py-3 text-sm font-medium text-white transition hover:scale-110 hover:shadow-xl focus:ring-3 focus:outline-hidden" href="#">
                    Contáctanos
                </a>
            </div>
        </div>
    
        
        <div class="w-full lg:w-1/2 bg-red-600 h-64 lg:h-auto"></div>
    </div>
    <section id="nuestrosProductos">
        <div class="px-4 py-12 lg:px-20">
            <div class="mb-8 text-center text-3xl">
                <span>Nuestros productos</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                <div>
                    <h2 class="p-3 text-lg font-semibold">Fletes Maritimos</h4>
                    <span class="text-sm text-gray-700">
                        Importacion y exportacion de mercancia en contenedores completos (FCL) o carga consolidada (LCL).
                    </span>
                </div>
        
                <div>
                    <h4 class="p-3 text-lg font-semibold">Fletes Aereos</h4>
                    <span class="text-sm text-gray-700">
                        Transporte rapido y seguro con las mejores tarifas y tiempos de entrega.
                    </span>
                </div>
        
                <div>
                    <h4 class="p-3 text-lg font-semibold">Transporte terrestre</h4>
                    <span class="text-sm text-gray-700">
                        Soluciones logisticas para envios nacionales e internacionales.
                    </span>
                </div>
        
                <div>
                    <h4 class="p-3 text-lg font-semibold">Aduana Importacion/Exportacion</h4>
                    <span class="text-sm text-gray-700">
                        Gestones aduaneras eficientes para importaciones y exportaciones.
                    </span>
                </div>
                <div>
                    <h4 class="p-3 text-lg font-semibold">Seguro de carga</h4>
                    <span class="text-sm text-gray-700">
                        Proteccion total para sus mercancias en cada etapa del transporte.
                    </span>
                </div>
                <div>
                    <h4 class="p-3 text-lg font-semibold">Courier y mensajeria</h4>
                    <span class="text-sm text-gray-700">
                        Servicio ágil y confiable para envios de documentos y pequeñas cargas a nivel nacional e internacional.
                    </span>
                </div>
                <div>
                    <h4 class="p-3 text-lg font-semibold">Almacenamiento de carga</h4>
                    <span class="text-sm text-gray-700">
                        Infraestructura para el resguardo seguro de mercancias. 
                    </span>
                </div>
                <div>
                    <h4 class="p-3 text-lg font-semibold">Asesorias en comercio exterior personalizadas</h4>
                    <span class="text-sm text-gray-700">
                        Consultoria especializada en logistica y normas de comercio internacional y procesos logisticos.  
                    </span>
                </div>
            </div>
        </div>
    </section>
    <section id="ourVendors">
        <div class="bg-[#F4F2EF] px-4 py-12 lg:px-20">
            <div class="mb-8 text-center text-3xl">
                <span>Nuestros proveedores</span>
            </div>
                
        </div>
    </section>
</Layout>

